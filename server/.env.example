# ---------------------------------------------------------------
# J.A.R.V.I.S. Server — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ---------------------------------------------------------------

# -- AI Brain ----------------------------------------------------
# Get a free Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Anthropic / Claude — swap in brain.js if preferred
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -- Database ----------------------------------------------------
# Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/jarvis

# Or MongoDB Atlas (cloud) — replace with your connection string
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/jarvis?retryWrites=true&w=majority

# -- Server ------------------------------------------------------
PORT=5000
NODE_ENV=development

# Session secret — change this to any long random string in production
SESSION_SECRET=replace_this_with_a_long_random_secret

# React client URL (update for production)
CLIENT_URL=http://localhost:5173
